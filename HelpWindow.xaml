<Window x:Class="CodyFormat.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help - CodyFormat" Height="670" Width="780" MinHeight="540" MinWidth="650"
        Icon="Assets/CodyFormat.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="CodyFormat" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Offline code formatting for Word, documentation and presentations." Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="11" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="What does CodyFormat do?" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,7"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="21"
                               Text="Paste source code into the editor. CodyFormat detects the language, formats it, applies syntax highlighting, previews the result, and copies or exports it with colors, indentation, line numbers, border and the selected background preserved."/>

                    <TextBlock Text="Formatting" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="21"
                               Text="JSON and XML are structurally parsed. SQL is tokenized and formatted by clauses, lists, joins and CASE blocks. HTML uses tag nesting. Brace-based languages use string/comment-aware indentation. Ruby, Lua and Bash use block-aware formatting. Indentation-sensitive formats are changed conservatively to avoid altering program meaning."/>

                    <TextBlock Text="Keyboard shortcuts" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <TextBlock Text="Shift+Alt+F   Format Code" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource BadgeTextBrush}"/>
                    <TextBlock Text="Ctrl+Enter    Format Code (SQLFormat-style shortcut)" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource BadgeTextBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="You can also right-click inside the editor and choose Format Code." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,0"/>

                    <TextBlock Text="None background" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="21"
                               Text="Enable None background to omit background fill from Preview, Copy for Word and DOCX export. Only the formatted colored code remains. Border is controlled separately."/>

                    <TextBlock Text="Privacy" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="21"
                               Text="Formatting and highlighting run locally. CodyFormat does not upload code, call an API, use telemetry or require an account. GitHub is opened only when you explicitly press the GitHub button."/>

                    <TextBlock Text="Supported languages" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="21"
                               Text="C#, SQL, JavaScript, TypeScript, Python, JSON, XML, HTML, CSS, PowerShell, Bash, Rust, Go, PHP, Java, C, C++, Kotlin, Swift, Dart, Ruby, Lua, R, Perl, YAML, Markdown, Objective-C, Scala and Groovy."/>

                    <TextBlock Text="Developer" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,7"/>
                    <TextBlock Text="LaneZeroO" Foreground="{DynamicResource BadgeTextBrush}" FontWeight="SemiBold"/>
                    <TextBlock Text="Version 0.3.1" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="GitHub" Click="GitHubClick" Style="{StaticResource AccentButton}"/>
            </StackPanel>
            <Button Content="Close" HorizontalAlignment="Right" Click="CloseClick"/>
        </Grid>
    </Grid>
</Window>
