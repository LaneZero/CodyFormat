<Window x:Class="CodyFormat.DonateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Donate - CodyFormat" Height="720" Width="780" MinHeight="580" MinWidth="680"
        Icon="Assets/CodyFormat.ico"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Support CodyFormat" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" Foreground="{DynamicResource SecondaryTextBrush}" LineHeight="20"
                       Text="CodyFormat is free and works entirely offline. If it saves you time, a donation helps keep free tools maintained, tested and available without ads, accounts or tracking."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="₿  Bitcoin" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Network: Bitcoin" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BitcoinText" IsReadOnly="True" Text="bc1q5tl36qpk27hf7upl8l753xa0gcm57adrvmwgkz" FontFamily="Cascadia Mono, Consolas" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource StrokeBrush}" Padding="10,8"/>
                            <Button Grid.Column="1" Content="Copy" Click="CopyBitcoinClick" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="💵  Tether" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Network: TRON / TRC20" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TetherText" IsReadOnly="True" Text="TA5pibChqS7CeHiDvfP7V3uQVMynk6SxLq" FontFamily="Cascadia Mono, Consolas" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource StrokeBrush}" Padding="10,8"/>
                            <Button Grid.Column="1" Content="Copy" Click="CopyTetherClick" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="🟣  EVM Networks" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Ethereum • BNB Smart Chain • Polygon" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="EvmText" IsReadOnly="True" Text="0x6634E26BA0e323182B7A9a89278E9a7BbCa9aF70" FontFamily="Cascadia Mono, Consolas" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource StrokeBrush}" Padding="10,8"/>
                            <Button Grid.Column="1" Content="Copy" Click="CopyEvmClick" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="☀  Solana" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Network: Solana" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="SolanaText" IsReadOnly="True" Text="91kuBFEZAnRk8ixsuzAQnAVvtzLAsQpPFRsfe285ZKUC" FontFamily="Cascadia Mono, Consolas" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource StrokeBrush}" Padding="10,8"/>
                            <Button Grid.Column="1" Content="Copy" Click="CopySolanaClick" Style="{StaticResource AccentButton}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource DangerBrush}" CornerRadius="9" Padding="13">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource DangerTextBrush}" LineHeight="20"
                               Text="⚠ Always verify the complete wallet address and blockchain network before transferring cryptocurrency. Cryptocurrency transactions generally cannot be reversed."/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="CopyStatus" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="Addresses are copied only when you press Copy."/>
            <Button Content="Close" HorizontalAlignment="Right" Click="CloseClick"/>
        </Grid>
    </Grid>
</Window>
