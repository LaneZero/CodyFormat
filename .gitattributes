# Normalize text files across Windows, Linux and macOS.
* text=auto

# Source and project files
*.cs      text eol=lf
*.axaml   text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.plist   text eol=lf
*.desktop text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf

# Shell scripts must stay LF on Unix-like systems.
*.sh      text eol=lf

# PowerShell and Visual Studio solution files are friendlier as CRLF on Windows.
*.ps1     text eol=crlf
*.sln     text eol=crlf

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.zip     binary
*.gz      binary
*.tar     binary
*.dmg     binary
*.pkg     binary
*.dll     binary
*.exe     binary
