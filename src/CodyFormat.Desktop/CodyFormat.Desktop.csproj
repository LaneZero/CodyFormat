<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CodyFormat</AssemblyName>
    <RootNamespace>CodyFormat.Desktop</RootNamespace>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\CodyFormat.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;win-arm64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <UseAppHost>true</UseAppHost>
    <Version>0.6.0</Version>
    <AssemblyVersion>0.6.0.0</AssemblyVersion>
    <FileVersion>0.6.0.0</FileVersion>
    <Authors>LaneZeroO</Authors>
    <Company>LaneZeroO</Company>
    <Product>CodyFormat</Product>
    <Description>Offline cross-platform code formatter and syntax highlighter.</Description>
    <RepositoryUrl>https://github.com/LaneZero/CodyFormat</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodyFormat.Core\CodyFormat.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
