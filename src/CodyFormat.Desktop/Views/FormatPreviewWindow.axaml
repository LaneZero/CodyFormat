<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodyFormat.Desktop.Views.FormatPreviewWindow"
        Title="Review formatting" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Icon="/Assets/CodyFormat.png">
  <Grid RowDefinitions="Auto,*,Auto" Margin="18">
    <StackPanel Grid.Row="0" Margin="4,0,4,12">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold"/>
      <TextBlock Text="Review the formatter result before changing the editor." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,12,*">
      <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="ORIGINAL" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" FontSize="10" Margin="2,0,0,8"/>
          <TextBox Grid.Row="1" x:Name="OriginalBox" IsReadOnly="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="10">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="FORMATTED" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold" FontSize="10" Margin="2,0,0,8"/>
          <TextBox Grid.Row="1" x:Name="FormattedBox" IsReadOnly="True" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
      </Border>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="Cancel" Click="CancelClick"/>
      <Button Content="Apply" Click="ApplyClick" Classes="accent"/>
    </StackPanel>
  </Grid>
</Window>
