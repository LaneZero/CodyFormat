<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodyFormat.Desktop.Views.HelpWindow"
        Title="CodyFormat Help" Width="760" Height="720" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" Icon="/Assets/CodyFormat.png">
  <Grid RowDefinitions="Auto,*,Auto" Margin="22">
    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="CodyFormat Help" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="14">
        <TextBlock Text="What CodyFormat does" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="CodyFormat formats, highlights, previews and exports source code locally. It does not upload your code, require an account, or call a cloud formatting API." TextWrapping="Wrap"/>
        <TextBlock Text="Workflow" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="1. Paste code or open/drop a local source file.&#10;2. Select a language or keep Auto Detect.&#10;3. Choose Dark/Light, background, font and indentation.&#10;4. Format the document or selected code.&#10;5. Copy plain text, Telegram Markdown, rich code for Word, or export DOCX." TextWrapping="Wrap"/>
        <TextBlock Text="Shortcuts" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Open file: Ctrl/Cmd + O&#10;Format document: Shift + Alt + F or Ctrl/Cmd + Enter&#10;Format selection: Ctrl/Cmd + Shift + F&#10;Undo: Ctrl/Cmd + Z" TextWrapping="Wrap"/>
        <TextBlock Text="Cross-platform notes" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="This preview uses Avalonia and a shared .NET 10 core on Windows, macOS and Linux. Clipboard richness is implemented with the native HTML clipboard format for each desktop OS. DOCX and Telegram output are generated by the same shared core on every platform." TextWrapping="Wrap"/>
        <TextBlock Text="Privacy" FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Source code stays in memory unless you explicitly export a DOCX. UI preferences are stored locally; source code is not saved in settings." TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="GitHub" Click="GitHubClick"/>
      <Button Content="Close" Click="CloseClick" Classes="accent"/>
    </StackPanel>
  </Grid>
</Window>
